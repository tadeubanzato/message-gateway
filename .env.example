# ---------------------------------------------------------------------------
# You do NOT need this file. Message Gateway is set up in the browser
# (http://localhost:8010) and keeps its settings, encrypted, in the database
# you choose (local SQLite or MongoDB Atlas).
#
# This file is only for advanced users who want to pin a setting from the
# environment. To use it:  cp .env.example .env  then uncomment what you need
# and recreate the container:  docker compose up -d --force-recreate
# (a plain `docker compose restart` does NOT reload .env).
#
# WARNING: any variable set here OVERRIDES what you enter in the web pages, and
# the pages can't change it. Only uncomment settings you want locked.
# ---------------------------------------------------------------------------

# --- Database (normally chosen in the setup page) ---
# DB_BACKEND=sqlite            # sqlite | atlas
# MONGODB_URI=
# MONGODB_DB=relay_gateway

# --- Secrets (normally generated automatically on first start) ---
# TOKEN_HMAC_SECRET=           # hashes API tokens. Changing it invalidates existing tokens
# SETTINGS_ENCRYPTION_KEY=     # Fernet key that encrypts saved credentials

# --- Message log ---
# STORE_MESSAGE_CONTENT=1      # 0 = keep metadata only, never the subject/body

# --- Portal ---
# PORTAL_SESSION_TTL_HOURS=24
# PORTAL_TEST_USER_KEY=        # dev only: adds a "log in as test user" button

# --- Public address (normally auto-detected; set in Settings, not here) ---
# The address shown on the About page (API examples, MCP endpoint) and handed to
# AI agents. Auto-detected from the request by default - only needed behind a
# reverse proxy or tunnel that doesn't forward the original Host header.
# PUBLIC_BASE_URL=https://gateway.example.com

# --- Provider defaults (normally chosen on the Channels pages) ---
# EMAIL_PROVIDER=mailjet       # mailjet | sendgrid
# SMS_PROVIDER=custom_http     # custom_http | twilio | infobip | sinch
# PUSH_PROVIDER=pushover       # pushover | ntfy

# --- Provider credentials (normally entered on the Channels pages) ---
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=
# MAILJET_FROM_NAME=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=
# INFOBIP_FROM=
# SINCH_SERVICE_PLAN_ID=
# SINCH_API_TOKEN=
# SINCH_REGION=us              # us | eu | au | br | ca
# SINCH_FROM_NUMBER=
# SMS_DEFAULT_TO=             # default phone number (with country code)
# CUSTOM_SMS_URL=              # your own SMS endpoint
# CUSTOM_SMS_METHOD=POST
# CUSTOM_SMS_HEADERS=          # e.g. Authorization: Bearer <token>
# CUSTOM_SMS_BODY=             # JSON with {{to}} and {{message}} placeholders
# CUSTOM_SMS_SUCCESS_TEXT=     # optional text the response must contain
# PUSHOVER_USER_KEY=
# PUSHOVER_APPS=default:PUSHOVER_APPTOKEN_DEFAULT
# PUSHOVER_APPTOKEN_DEFAULT=
# NTFY_TOPIC=
# NTFY_SERVER_URL=https://ntfy.sh
# NTFY_AUTH_TOKEN=

# --- Timeouts (seconds) ---
# MAILJET_TIMEOUT_SECS=10
# SENDGRID_TIMEOUT_SECS=10
# TWILIO_TIMEOUT_SECS=15
# INFOBIP_TIMEOUT_SECS=15
# SINCH_TIMEOUT_SECS=15
# CUSTOM_SMS_TIMEOUT_SECS=15
# PUSHOVER_TIMEOUT_SECS=10
# NTFY_TIMEOUT_SECS=10

# --- Port on your machine (also readable as an environment variable) ---
# MG_PORT=8010
