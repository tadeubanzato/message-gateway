# Copy this file to .env and fill in real values. Never commit .env.
# Only the values for your ACTIVE providers below need to be set — everything
# else can stay blank. The setup wizard (via MCP) can walk you through this
# conversationally: connect your agent to the MCP server and ask it to help
# you configure email/SMS/push. See README.md for the exact prompt to use.

# ---------------------------------------------------------------------
# Database backend: sqlite (default, zero external accounts needed) or atlas
# ---------------------------------------------------------------------
DB_BACKEND=sqlite

# Only used when DB_BACKEND=sqlite (default path inside the container's data volume)
SQLITE_PATH=/app/data/gateway.db

# Only required when DB_BACKEND=atlas
MONGODB_URI=
MONGODB_DB=relay_gateway

# ---------------------------------------------------------------------
# Auth — secret used to HMAC-hash API tokens before storing/looking them up
# ---------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_HMAC_SECRET=

# ---------------------------------------------------------------------
# Portal
# ---------------------------------------------------------------------
PORTAL_SESSION_COOKIE=portal_sid
PORTAL_SESSION_TTL_HOURS=24
PORTAL_PBKDF2_ITERS=260000
# Optional: pinned test login for local dev only. Leave blank in production.
PORTAL_TEST_USER_KEY=

# ---------------------------------------------------------------------
# Templates
# ---------------------------------------------------------------------
TEMPLATES_DIR=/app/app/templates
SMS_TEMPLATE_DIR=/app/app/templates/sms
EMAIL_TEMPLATE_DIR=/app/app/templates/email
TEMPLATE_STRICT=true

# ---------------------------------------------------------------------
# RabbitMQ — runs inside this same container, no external broker needed
# ---------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
RABBITMQ_EXCHANGE=events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=outbound.send
RABBITMQ_DLX_EXCHANGE=events.dlx
RABBITMQ_MANAGEMENT_PORT=15672

EMAIL_QUEUE_NAME=notify.email
SMS_QUEUE_NAME=notify.sms
PUSH_QUEUE_NAME=notify.push

# ---------------------------------------------------------------------
# MCP server — shares the same port as the HTTP API, path /mcp
# ---------------------------------------------------------------------
# Public URL agents should connect to (shown on /get-started and in README).
PUBLIC_MCP_URL=http://localhost:8010/mcp
GATEWAY_BASE_URL=http://localhost:8010

# ---------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------
EMAIL_PROVIDER=mailjet        # mailjet | sendgrid
SMS_PROVIDER=twilio           # twilio | infobip | local_modem
PUSH_PROVIDER=pushover        # pushover | ntfy

# --- Email: Mailjet ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Relay Gateway
MAILJET_API_URL=https://api.mailjet.com/v3.1/send
MAILJET_TIMEOUT_SECS=10

# --- Email: SendGrid ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Relay Gateway
SENDGRID_TIMEOUT_SECS=10

# --- SMS: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TIMEOUT_SECS=15

# --- SMS: Infobip ---
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_FROM=
INFOBIP_TIMEOUT_SECS=15

# --- SMS: local modem (self-hosted HTTP API in front of ModemManager/mmcli) ---
SMS_API_BASE_URL=
SMS_API_TOKEN=
SMS_HTTP_TIMEOUT_SECONDS=15

# --- Push: Pushover ---
PUSHOVER_USER_KEY=
# Map app names to your own env var names, then define each of those env
# vars with its own Pushover application token. Example:
#   PUSHOVER_APPS=default:PUSHOVER_APPTOKEN_DEFAULT,work:PUSHOVER_APPTOKEN_WORK
PUSHOVER_APPS=default:PUSHOVER_APPTOKEN_DEFAULT
PUSHOVER_APPTOKEN_DEFAULT=
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json
PUSHOVER_TIMEOUT_SECS=10

# --- Push: ntfy (open source, free — public ntfy.sh or self-hosted) ---
NTFY_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh
NTFY_AUTH_TOKEN=
NTFY_TIMEOUT_SECS=10
